# MediTrust environment variables (copy to .env and fill in real values; never commit .env)
# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=
DEMO_MONGODB_URI=
DEMO_MODE=false
CORS_ORIGIN=http://localhost:5173
ADMIN_API_KEY=
# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
LLM_RPM=15
# openFDA ingestion
OPENFDA_API_KEY=
# Client
VITE_API_URL=http://localhost:4000
# Ingestion
CDSCO_RAW_DIR=data/raw
